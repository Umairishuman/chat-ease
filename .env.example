# Copy this file to `.env.local` for local development, and set the same
# variables in your hosting provider's dashboard for production.

# --- Required -----------------------------------------------------------------

# MongoDB connection string (e.g. MongoDB Atlas).
# For Atlas, allow your host's outbound IPs (or 0.0.0.0/0) under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat-ease?retryWrites=true&w=majority

# Secret used to sign session JWTs. Must be long and random in production.
# Generate one with: openssl rand -base64 48
JOSE_SECRET=

# --- Google Sign-In -------------------------------------------------------------
# OAuth 2.0 Client ID from Google Cloud Console. Add your production URL to
# "Authorized JavaScript origins". NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Avatar uploads (Cloudinary, unsigned upload preset) --------------------------
# NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dfr57apl2
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=chat-ease-profilepics

# --- Password reset emails (Gmail) ---------------------------------------------
# Use a Gmail App Password (requires 2-Step Verification), not your account password.
EMAIL_USER=
EMAIL_PASS=
